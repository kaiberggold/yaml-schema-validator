{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension (example workspace)",
            "type": "extensionHost",
            "request": "launch",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/example"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "bundle"
        }
    ]
}
